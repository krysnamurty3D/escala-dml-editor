rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dados do usuário — apenas autenticado
    match /usuarios/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Colaboradores e convites — autenticado
    match /convites/{id} {
      allow read, write: if request.auth != null;
    }

    // Riders — público (líderes sem login). Nada no app exclui um rider pelo
    // cliente, então delete fica bloqueado — evita que alguém com a chave
    // pública do Firebase apague documentos em massa.
    match /riders/{slug} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Solicitações de Equipamento — público (líderes sem login). Deferir/
    // indeferir só atualiza o status (merge), nunca apaga — delete bloqueado.
    match /solicitacoes/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Estúdio (checklist + horário de ensaio) — público (líderes sem login)
    match /estudio/{slug} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Comunicações — agenda externa dos grupos — público (líderes sem login)
    match /agendaExterna/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Escala pública ao vivo — a página pública lê direto daqui (sem republicar
    // arquivo estático); o editor grava ao salvar/ocultar a escala
    match /escalaPublica/{doc} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Tokens de notificação push — público (líderes sem login se cadastram
    // pelo próprio token; o coordenador se cadastra autenticado, mas a
    // coleção fica aberta pelo mesmo motivo das demais acima). A limpeza de
    // tokens inválidos roda no Cloud Function com Admin SDK, que não passa
    // por estas regras — então bloquear delete aqui não afeta essa limpeza.
    match /pushTokens/{token} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Configurações públicas (PINs de rider, comunicados aos líderes,
    // checklist do estúdio, instrumentos disponíveis) — antes viviam como
    // arquivos estáticos no GitHub (rider-config.json etc), lidos via
    // raw.githubusercontent.com pela página pública. Isso tinha alguns
    // minutos de cache de CDN, o que causava "está desatualizado no
    // celular" mesmo depois de salvar. Agora ficam aqui: leitura pública
    // (líderes sem login), escrita apenas pelo dono autenticado.
    match /configPublica/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
